{
  "expo": {
    "name": "Purrtrack",
    "slug": "purrtrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "purrtrack",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": "./src/assets/images/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.jjjooeyyy.purrtrack",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Purrtrack needs access to your photo library so you can choose a cat profile picture.",
        "UIBackgroundModes": ["remote-notification"],
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "purrtrack",
              "com.googleusercontent.apps.468701470427-1bjkg2pvpipvpra7j6633saif6gc1i3j"
            ]
          }
        ]
      },
      "googleServicesFile": "./GoogleService-Info.plist",
      "appleTeamId": "3UT9PHW9BU"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/assets/images/android-icon-foreground.png",
        "backgroundImage": "./src/assets/images/android-icon-background.png",
        "monochromeImage": "./src/assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.jjjooeyyy.purrtrack"
    },
    "notification": {
      "color": "#7FA655"
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-localization",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
