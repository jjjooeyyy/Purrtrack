rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow journal image upload if user is a member/owner of the pet (matches Firestore logic)
    match /pets/{petId}/journal/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        // User is pet owner
        get(/databases/$(database)/documents/pets/$(petId)).data.createdByUid == request.auth.uid ||
        // User is member
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/petMemberships/$(petId))
      );
    }
  }
}